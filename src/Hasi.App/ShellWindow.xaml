<Window x:Class="Hasi.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HASI"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="Black"
        FontFamily="Segoe UI">
    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ScreenTitle"
                   Foreground="White"
                   FontSize="40"
                   FontWeight="Bold"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="Message"
                   Grid.Row="1"
                   Margin="0,32,0,0"
                   Foreground="Yellow"
                   FontSize="64"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
