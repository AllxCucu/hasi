<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>hasi</AssemblyName>
    <RootNamespace>Hasi.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Velopack's hooks must run before WPF starts (Program.Main). -->
    <StartupObject>Hasi.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hasi.Core\Hasi.Core.csproj" />
    <ProjectReference Include="..\Hasi.Speech\Hasi.Speech.csproj" />
    <ProjectReference Include="..\Hasi.Text.Ro\Hasi.Text.Ro.csproj" />
    <ProjectReference Include="..\Modules\Hasi.Modules.Settings\Hasi.Modules.Settings.csproj" />
    <ProjectReference Include="..\Modules\Hasi.Modules.KeyTutor\Hasi.Modules.KeyTutor.csproj" />
    <ProjectReference Include="..\Modules\Hasi.Modules.About\Hasi.Modules.About.csproj" />
    <ProjectReference Include="..\Modules\Hasi.Modules.Exit\Hasi.Modules.Exit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\ro.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
