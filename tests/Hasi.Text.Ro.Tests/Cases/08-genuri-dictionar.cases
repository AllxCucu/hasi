# Genul substantivelor din dicționarul MULTEXT-East (Data/substantive.txt), pentru cuvinte care nu sunt
# în lista scrisă de mână. Neutrul: masculin la singular, feminin la plural.

2 autobuze => două autobuze
2 scaune => două scaune
22 de scaune => douăzeci și două de scaune
2 câini => doi câini
1 câine => un câine
1 pâine => o pâine
2 mere => două mere
21 de flori => douăzeci și una de flori
12 telefoane => douăsprezece telefoane
2 medicamente => două medicamente
32 ziare => treizeci și două de ziare

# Cuvinte necunoscute, cu genul ghicit din terminație (ADR 0005, pașii 3–5, alegerea testerului din 23.10.2026).
2 hasiuri => două hasiuri
25 xyzw => douăzeci și cinci de xyzw

# Plural necunoscut după un număr (regula testerului, 23.10.2026): -e și -uri dau „două”;
# -i e ambiguu: rămâne masculin și apare ca LEXICON? în jurnal.
2 smartfoane => două smartfoane
2 tramvaiele => două tramvaiele
2 meciurile => două meciurile
2 bitcoini => doi bitcoini
